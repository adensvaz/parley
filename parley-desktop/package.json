{
  "name": "parley-desktop",
  "productName": "Parley",
  "version": "0.1.0",
  "description": "Parley — real-time cold-call AI copilot for real estate & sales",
  "author": "Parley",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "server": "tsx server/gateway.ts",
    "test": "tsx qa/run.ts",
    "typecheck": "tsc --noEmit",
    "package": "vite build && electron-builder --mac --dir",
    "dist": "vite build && electron-builder --mac"
  },
  "build": {
    "appId": "com.parley.desktop",
    "productName": "Parley",
    "copyright": "Copyright © 2026 Aden Vaz",
    "directories": { "output": "release", "buildResources": "build" },
    "files": ["dist/**/*", "dist-electron/**/*", "package.json"],
    "mac": {
      "icon": "build/icon.icns",
      "category": "public.app-category.business",
      "target": [{ "target": "dir", "arch": ["arm64"] }],
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Parley listens to your side of the call to coach you in real time.",
        "NSCameraUsageDescription": "Not used by Parley.",
        "LSUIElement": false
      }
    }
  },
  "dependencies": {
    "@deepgram/sdk": "^3.9.0",
    "openai": "^4.77.0",
    "ws": "^8.18.0",
    "zustand": "^5.0.2",
    "electron-updater": "^6.8.3",
    "electron-log": "^5.4.3"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@tanstack/react-router": "^1.90.0",
    "vite": "^6.0.0",
    "vite-plugin-electron": "^0.29.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
